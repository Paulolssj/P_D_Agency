  </head>
  <body class="bg-white text-black antialiased selection:bg-[#E02424] selection:text-white">
    <div id="root">
      <!-- Instant Hero Skeleton (Pre-render for 100/100 Lighthouse LCP) -->
      <section style="position: relative; min-height: 85vh; background-color: #0a0a0a; color: white; display: flex; flex-direction: column; justify-content: center; overflow: hidden; padding-top: 7rem; padding-bottom: 3rem; text-align: left; font-family: 'Space Grotesk', system-ui, sans-serif;">
        <div style="position: absolute; inset: 0; z-index: 0; background-color: #0a0a0a;">
          <div style="position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.5) 100%);"></div>
        </div>
        <div style="max-width: 80rem; margin-left: auto; margin-right: auto; padding-left: 1.5rem; padding-right: 1.5rem; width: 100%; position: relative; z-index: 10; box-sizing: border-box;">
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; background-color: rgba(23, 23, 23, 0.9); border: 1px solid #262626; padding: 0.5rem 1rem; font-size: 0.75rem; font-weight: 600; color: #e5e5e5; margin-bottom: 1.5rem; border-radius: 9999px;">
            <span style="color: #E02424;">★★★★★</span>
            <span>4.9</span>
            <span style="width: 6px; height: 6px; border-radius: 50%; background-color: rgba(224, 36, 36, 0.4);"></span>
            <span>Suporte Técnico Taça do Mundo UCI</span>
          </div>
          <h1 style="font-size: 3rem; font-weight: 900; letter-spacing: -0.05em; line-height: 0.9; margin: 0 0 1.5rem 0; text-transform: uppercase;">
            AGOSTINHO <br />
            <span style="color: #E02424;">BIKES</span>
          </h1>
          <div style="width: 6rem; height: 4px; background-color: #E02424; margin-bottom: 1.5rem;"></div>
          <p style="font-size: 1.125rem; color: #d4d4d4; max-width: 36rem; margin: 0 0 2.5rem 0; line-height: 1.625;">
            A sua loja e oficina mecânica de referência em Pombal.
          </p>
        </div>
      </section>
    </div>
  </body>
</html>
